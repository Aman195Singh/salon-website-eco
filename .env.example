# ==============================================================================
# Salon Website & V2 Booking Management - Environment Variables Template
# Copy this file to .env.local and fill in your actual Supabase project values.
# NEVER commit your actual .env.local or service keys to public Git repositories.
# ==============================================================================

# 1. Supabase Public Client Credentials (Required)
# Found in: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# 2. Production Site URL (Optional, defaults to localhost:3000 in dev)
NEXT_PUBLIC_SITE_URL=https://salon-website-eco.vercel.app

# 3. Server-Side Administrative Service Role (Optional, for backend scripts only)
# NEVER expose this key to client-side code with NEXT_PUBLIC_ prefix!
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# 4. Optional Test Accounts for Local Automated Regression
TEST_OWNER_EMAIL=owner@example.com
TEST_OWNER_PASSWORD=your-secure-password
